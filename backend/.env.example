# Copy to .env and fill in. Every setting in app/config.py can be overridden here.
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b

# auto | cpu | cuda
DEVICE=auto
# false = lighter/faster (no 2.2 GB reranker), less precise
USE_RERANKER=true

# Selection (see README): best chunk below MIN_RERANK_SCORE → abstain
MAX_K=3
REL_CUTOFF=0.5
MIN_RERANK_SCORE=0.10
MAX_CONTEXT_CHARS=2200

CORS_ORIGINS=http://localhost:5173
