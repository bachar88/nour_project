# For LOCAL runs only (copy to backend/.env). On Vercel, set the same names in
# Project → Settings → Environment Variables. Never commit real keys.

# Supabase → Project Settings → API (use the SECRET / service_role key: server side only)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Cloudflare → Account ID (Workers & Pages page) + API token from the "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Groq → console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss: low | medium | high (thinking tokens count against the free limits)
REASONING_EFFORT=low
MAX_TOKENS=1024

# Selection — tune with notebooks/nour_admin.ipynb (step 4)
MIN_COSINE_SCORE=0.45
COSINE_MARGIN=0.06
MAX_K=3
MAX_CONTEXT_CHARS=2200

# Learning loop (see LEARNING.md) — turn on once app/learning.py is written
USE_CORRECTIONS=false
CORRECTION_MIN_SIMILARITY=0.85
MAX_CORRECTION_EXAMPLES=2
